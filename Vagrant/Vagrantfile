# -*- mode: ruby -*-
require "yaml"
root = File.expand_path("..", __dir__)
settings_path = File.join(root, "config.yml")
abort "Copia config.example.yml a config.yml y configura la contraseña de administrador." unless File.file?(settings_path)
settings = YAML.safe_load(File.read(settings_path))
vm = settings.fetch("vm")
pz = settings.fetch("pz")
abort "Java debe dejar al menos 2048 MB libres para el sistema." unless pz.fetch("heap_max_mb") + 2048 <= vm.fetch("memory_mb")
Vagrant.configure("2") do |config|
  config.vm.box = vm.fetch("box")
  config.vm.box_version = vm["box_version"] if vm["box_version"]
  config.vm.hostname = vm.fetch("hostname")
  # Allow the game's graceful stop timeout plus time for Ubuntu to shut down.
  config.vm.graceful_halt_timeout = pz.fetch("shutdown_timeout") + 120
  config.vm.synced_folder root, "/vagrant", mount_options: ["ro"]
  case vm.fetch("network")
  when "private"
    config.vm.network "private_network", ip: vm.fetch("ip")
  when "public"
    options = {}
    options[:ip] = vm["ip"] if vm["ip"] && !vm["ip"].empty?
    options[:bridge] = vm["bridge"] if vm["bridge"] && !vm["bridge"].empty?
    config.vm.network "public_network", **options
  else
    abort "vm.network debe ser private o public."
  end
  config.vm.provider "virtualbox" do |vb|
    vb.name = vm.fetch("name")
    vb.memory = vm.fetch("memory_mb")
    vb.cpus = vm.fetch("cpus")
  end
  # Ubuntu's package includes community.general; avoid the moving Ansible PPA.
  config.vm.provision "shell", inline: "apt-get update && apt-get install -y ansible"
  config.vm.provision "ansible_local" do |ansible|
    ansible.install = false
    ansible.provisioning_path = "/vagrant"
    ansible.playbook = "Ansible/site.yml"
  end
end
